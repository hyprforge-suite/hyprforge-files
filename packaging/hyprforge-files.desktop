[Desktop Entry]
Type=Application
Name=Hyprforge Files
GenericName=File Manager
Comment=Browse, organise and preview your files
# No absolute path: the installer puts the binary on PATH, and hardcoding
# a prefix is what makes a .desktop file break when someone installs
# somewhere else.
Exec=hyprforge-files %U
# The name of an icon theme entry, not a file. No icon ships yet, so
# launchers fall back to a generic one — correct behaviour for a missing
# icon, and better than pointing at a path that does not exist.
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
Keywords=files;folder;browse;manager;explorer;finder;
StartupNotify=true
# Declaring this is what lets "Open containing folder" in other
# applications, and `xdg-open` on a directory, reach this program at all.
# inode/directory is the type a folder has; the x-scheme handler is how a
# trash:// URI is routed.
#
# Never x-scheme-handler/file. GLib's launch_default_for_uri asks the
# *scheme's* handler before it looks at the file's type, and `gio open
# photo.png` goes through a file:// URI — so claiming the scheme made this
# program the opener of every file on the machine, whatever mimeapps.list
# said. Double-clicking a picture in Files re-raised Files instead of
# starting the viewer. A folder reaches this program through
# inode/directory, which is all the scheme claim was ever meant to do.
MimeType=inode/directory;x-scheme-handler/trash;
